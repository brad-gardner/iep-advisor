# Sentry DSN for frontend error tracking
# Get your DSN from https://sentry.io → Settings → Client Keys
VITE_SENTRY_DSN=

# Sidebar footer "Trust & privacy" link. Full URL to the trust page — not just
# the marketing site's base. Defaults to https://iep-advisor.com/trust.html
# when unset.
VITE_MARKETING_URL=
